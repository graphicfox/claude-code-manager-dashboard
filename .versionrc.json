{
  "types": [
    { "type": "feat",     "section": "Features" },
    { "type": "fix",      "section": "Bug Fixes" },
    { "type": "perf",     "section": "Performance" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "revert",   "section": "Reverts" },
    { "type": "docs",     "section": "Documentation" },
    { "type": "build",    "section": "Build" },
    { "type": "ci",       "hidden": true },
    { "type": "chore",    "hidden": true },
    { "type": "test",     "hidden": true },
    { "type": "style",    "hidden": true }
  ],
  "commitUrlFormat": "https://github.com/graphicfox/claude-code-manager-dashboard/commit/{{hash}}",
  "compareUrlFormat": "https://github.com/graphicfox/claude-code-manager-dashboard/compare/{{previousTag}}...{{currentTag}}",
  "issueUrlFormat": "https://github.com/graphicfox/claude-code-manager-dashboard/issues/{{id}}"
}
